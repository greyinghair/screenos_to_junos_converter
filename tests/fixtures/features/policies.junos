set applications application udp_161 protocol udp destination-port 161
set applications application-set junos-dns application junos-dns-udp
set applications application-set junos-dns application junos-dns-tcp
set applications application tcp_443 protocol tcp destination-port 443
set security zones security-zone Trust address-book address src1 192.0.2.1
set security zones security-zone Trust address-book address src2 192.0.2.2
set security zones security-zone Untrust address-book address dst1 198.51.100.1
set security zones security-zone Untrust address-book address dst2 198.51.100.2
set security policies from-zone Trust to-zone Untrust policy 7 match source-address src1
set security policies from-zone Trust to-zone Untrust policy 7 match destination-address dst1
set security policies from-zone Trust to-zone Untrust policy 7 match application tcp_443
set security policies from-zone Trust to-zone Untrust policy 7 then permit
set security policies from-zone Trust to-zone Untrust policy 7 match source-address src2
set security policies from-zone Trust to-zone Untrust policy 7 match destination-address dst2
set security policies from-zone Trust to-zone Untrust policy 7 match application tcp_443
