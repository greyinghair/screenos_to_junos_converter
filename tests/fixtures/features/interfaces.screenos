set interface ethernet0/0 description "Outside uplink"
set interface ethernet0/0 zone "Untrust"
set interface ethernet0/0 ip 198.51.100.1/24
set interface ethernet0/0 mtu 1500
set interface ethernet0/1.100 tag 100
set interface ethernet0/1.100 description "Users VLAN"
set interface ethernet0/1.100 zone "Trust"
set interface ethernet0/1.100 ip 192.0.2.1/24
set interface ethernet0/1.100 ipv6 ip 2001:db8:100::1/64
set interface mgt ip 203.0.113.10/24
set interface tunnel.1 zone "VPN"
set interface tunnel.1 ip unnumbered interface ethernet0/0
set interface vlan200 tag 200
set interface vlan200 zone "DMZ"
set interface vlan200 ip 203.0.113.1/24
set interface ethernet0/2 phy link-down
