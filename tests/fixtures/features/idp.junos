set security idp dynamic-attack-group screenos_low_http_sigs filters service values HTTP
set security idp dynamic-attack-group screenos_low_http_sigs filters type values signature
set security idp idp-policy screenos_untrust_trust_inspect_web_idp rulebase-ips rule rule_003 match from-zone Untrust
set security idp idp-policy screenos_untrust_trust_inspect_web_idp rulebase-ips rule rule_003 match to-zone Trust
set security idp idp-policy screenos_untrust_trust_inspect_web_idp rulebase-ips rule rule_003 match source-address any
set security idp idp-policy screenos_untrust_trust_inspect_web_idp rulebase-ips rule rule_003 match destination-address any
