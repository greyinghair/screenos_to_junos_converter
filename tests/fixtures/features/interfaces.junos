set applications application udp_161 protocol udp destination-port 161
set applications application-set junos-dns application junos-dns-udp
set applications application-set junos-dns application junos-dns-tcp
set interfaces ge-0/0/0 description "Outside uplink"
set interfaces ge-0/0/0 mtu 1500
set interfaces ge-0/0/0 unit 0 family inet address 198.51.100.1/24
set security zones security-zone Untrust interfaces ge-0/0/0.0
set interfaces ge-0/0/1 vlan-tagging
set interfaces ge-0/0/1 unit 100 vlan-id 100
set interfaces ge-0/0/1 unit 100 description "Users VLAN"
set interfaces ge-0/0/1 unit 100 family inet address 192.0.2.1/24
set interfaces ge-0/0/1 unit 100 family inet6 address 2001:db8:100::1/64
set security zones security-zone Trust interfaces ge-0/0/1.100
set interfaces fxp0 unit 0 family inet address 203.0.113.10/24
set security zones security-zone System-Management interfaces fxp0.0
set interfaces st0 unit 1 family inet unnumbered-address ge-0/0/0.0
set security zones security-zone VPN interfaces st0.1
set vlans screenos_vlan_200 vlan-id 200
set vlans screenos_vlan_200 l3-interface irb.200
set interfaces irb unit 200 family inet address 203.0.113.1/24
set security zones security-zone DMZ interfaces irb.200
set interfaces ge-0/0/2 disable
